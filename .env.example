APP_NAME="নবদুর্গা"
APP_ENV=local
APP_DEBUG=true
# If DocumentRoot points at /public (vhost / shared hosting), use the domain root, e.g. https://example.com
# If accessing via plain XAMPP htdocs subfolder (no vhost), use that folder without /public, e.g. http://localhost/navadurga
APP_URL=http://localhost/navadurga
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=navadurga_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

SESSION_NAME=navadurga_session
SESSION_LIFETIME=120

MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=info@navadurga.local

CURRENT_NAVARATRI_YEAR=2026
