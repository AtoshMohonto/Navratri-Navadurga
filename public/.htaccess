RewriteEngine On

# Serve existing files/directories directly (assets, uploads, etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller
RewriteRule ^ index.php [L]

# Security: block dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Sensible defaults
Options -Indexes
